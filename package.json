{
  "name": "personal-nutc-eportal",
  "version": "6.2.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Access protected NUTC dashboard with independent server-side ePortal Playwright session.",
  "scripts": {
    "start": "npm run build && node server.js",
    "doctor": "node scripts/doctor.mjs",
    "deploy:check": "node scripts/deploy-check.mjs",
    "deploy:configure": "node scripts/configure-deploy.mjs",
    "install-browser": "node scripts/install-browser.mjs",
    "check": "node scripts/check-syntax.mjs",
    "login": "node scripts/portal-login.mjs",
    "portal:status": "node scripts/portal-status.mjs",
    "run": "node scripts/portal-run.mjs",
    "test": "node --test test/*.test.js",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "postinstall": "npm run build",
    "verify": "npm run build && npm run check && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^5.10.0",
    "lucide-react": "^0.468.0",
    "opencc-js": "^1.4.2",
    "playwright": "^1.50.0",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "vite": "^6.3.5"
  }
}
